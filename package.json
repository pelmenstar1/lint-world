{
  "name": "lint-world",
  "version": "1.0.0",
  "description": "Run every linter in your project with one command",
  "packageManager": "pnpm@11.24.0",
  "license": "MIT",
  "author": "Oleh Khmaruk <pelmenstar1@gmail.com>",
  "keywords": [
    "lint",
    "linter",
    "eslint",
    "prettier",
    "stylelint",
    "knip",
    "tsc"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": "dist/cli.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pelmenstar1/lint-world.git"
  },
  "files": [
    "dist",
    "package.json",
    "!dist/__tests__"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "tsx src/cli.ts",
    "lint:fix": "pnpm lint --fix",
    "test": "vitest run",
    "prepare": "husky"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "execa": "^10.0.0",
    "jiti": "^2.7.0",
    "minimist": "^1.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/minimist": "^1.2.5",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "knip": "^6.29.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
